          <a aria-label='انستغرام' class='fin-footer-social' href='https://www.instagram.com/achraf_ayaou/' rel='noopener noreferrer' style='background:var(--social-instagram)' target='_blank'><i class='fab fa-instagram'/></a>
          <a aria-label='فيسبوك' class='fin-footer-social' href='https://m.facebook.com/Achraf.ayaouu/' rel='noopener noreferrer' style='background:var(--social-facebook)' target='_blank'><i class='fab fa-facebook-f'/></a>
          <a aria-label='لينكدإن' class='fin-footer-social' href='https://www.linkedin.com/in/achraf-ayaou-40a970196' rel='noopener noreferrer' style='background:var(--social-linkedin)' target='_blank'><i class='fab fa-linkedin-in'/></a>
          <a aria-label='تيك توك' class='fin-footer-social' href='https://www.tiktok.com/@a_lavish_p' rel='noopener noreferrer' style='background:var(--social-tiktok)' target='_blank'><i class='fab fa-tiktok'/></a>
